{%- set big_dtype = example_tensor_meta.big_dtype -%}
{%- set data = example_tensor_meta.data -%}
{%- set min = example_tensor_meta.min -%}
{%- set max = example_tensor_meta.max -%}
{%- set mean = example_tensor_meta.mean -%}
{%- set std = example_tensor_meta.std -%}
{%- if data != None -%}
    shape = {{shape}}
    dtype = '{{dtype}}'
    data = {{data}}
    {{ "" }}
{%- elif big_dtype == "bool" -%}
    shape = {{shape}}
    dtype = 'bool'
    min_val = 0
    max_val = 2
    data = None
    {{ "" }}
{%- elif big_dtype == "int64" -%}
    shape = {{shape}}
    dtype = '{{dtype}}'
    min_val = {{min}}
    max_val = {{max}}
    data = None
    {{ "" }}
{%- elif big_dtype == "float64" -%}
    shape = {{shape}}
    dtype = '{{dtype}}'
    {%- if min is not none %}
    min_val = float('{{min}}')
    {%- endif %}
    {%- if max is not none %}
    max_val = float('{{max}}')
    {%- endif %}
    {%- if mean is not none %}
    mean = float('{{mean}}')
    {%- endif %}
    {%- if std is not none %}
    std = float('{{std}}')
    {%- endif %}
    data = None
    {{ "" }}
{%- endif -%}
{%- endmacro %}


